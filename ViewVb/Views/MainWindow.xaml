
<Window x:Class="Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewVb"
    xmlns:WpfControl.Sample="clr-namespace:WpfControl.Sample;assembly=WpfControl"
    Title="MainWindow"
    Height="512" Width="440"
>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool2Visible" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="mnuFileExit_Click" />
      </MenuItem>
      <MenuItem Header="_Bitmap">
        <MenuItem Header="Draw 16"
            Command="{Binding RunModelTaskCommand}"
            CommandParameter="16"
        />
        <MenuItem Header="_Draw 100"
            Command="{Binding RunModelTaskCommand}"
            CommandParameter="100"
        />
        <MenuItem Header="Clear _Black"
            Command="{Binding ClearImageCommand}"
            CommandParameter="0xFF000000"
        />
        <MenuItem Header="Clear _White"
            Command="{Binding ClearImageCommand}"
            CommandParameter="0xFFFFFFFF"
        />
      </MenuItem>
    </Menu>

    <StackPanel Orientation="Vertical">
      <Image Stretch="None" Source="{Binding SourceBitmap}" />
    </StackPanel>
  </DockPanel>

</Window>
